# Hosted/staging template. Copy to a secret-managed environment and replace
# every GENERATE_* value with an independent random 32+ character secret.
DATABASE_URL=postgresql://signalgate:REPLACE_DB_PASSWORD@db:5432/signalgate
BACKEND_BASE_URL=https://api.example.com
REQUIRE_LICENSE=true
DEMO_ONLY_MODE=true

EA_API_KEY=GENERATE_EA_SECRET_32_CHARS_MINIMUM
ADMIN_API_KEY=GENERATE_ADMIN_SECRET_32_CHARS_MINIMUM
SIGNAL_PROVIDER_API_KEY=GENERATE_PROVIDER_SECRET_32_CHARS_MINIMUM
REGISTRATION_API_KEY=GENERATE_BOT_SECRET_32_CHARS_MINIMUM

TELEGRAM_BOT_TOKEN=REPLACE_IF_BOT_ENABLED
ADMIN_TELEGRAM_IDS=
SIGNAL_PROVIDER_TELEGRAM_IDS=
SIGNAL_PROVIDER_INVITE_CODE=

SIGNAL_EXTRACTOR=fake
ANTHROPIC_API_KEY=


# Backups fail closed unless an age public recipient is configured.
# Keep the corresponding private identity in the separate recovery secret store.
BACKUP_AGE_RECIPIENT=age1replace_with_operations_public_recipient
