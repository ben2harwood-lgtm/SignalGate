DATABASE_URL=sqlite:///./signalgate.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_BASE_URL=http://127.0.0.1:8000

TELEGRAM_BOT_TOKEN=replace_me
ADMIN_TELEGRAM_IDS=123456789
# Limited role for people like Nick: can send screenshots, confirm extraction,
# and broadcast the resulting demo trade card. Cannot pause/resume or view admin logs.
SIGNAL_PROVIDER_TELEGRAM_IDS=
# Optional frictionless enrolment: Nick sends /provider this-code to the bot.
SIGNAL_PROVIDER_INVITE_CODE=

EA_API_KEY=local-demo-ea-key

# Tradeable symbols. Empty = allow every pair the parser recognises (all forex
# majors/minors/crosses, metals XAUUSD/XAGUSD, and crypto BTCUSD/ETHUSD...).
# Set a comma-separated list to restrict a desk to just a provider's pairs, e.g.
# ALLOWED_SYMBOLS=EURUSD,GBPUSD,GBPJPY,USDJPY
ALLOWED_SYMBOLS=

# Screenshot reading:
# Use "claude" with ANTHROPIC_API_KEY for real image extraction.
# Use "fake" only for offline/demo plumbing tests.
SIGNAL_EXTRACTOR=claude
ANTHROPIC_API_KEY=replace_me
# High-resolution vision model for reading chart price levels. Leave as-is.
SIGNAL_EXTRACTOR_MODEL=claude-opus-4-8

# HOSTED MULTI-CUSTOMER MODE
# Leave REQUIRE_LICENSE=false for local/solo demo (identify EA by user_id).
# Set REQUIRE_LICENSE=true on the shared server so each EA must present a
# valid, ACTIVE customer license key (issued via /admin/users/.../issue_license).
REQUIRE_LICENSE=false
# For the hosted server, point DATABASE_URL at PostgreSQL instead of SQLite, e.g.:
# DATABASE_URL=postgresql://signalgate:CHANGE_ME@localhost:5432/signalgate

DEMO_ONLY_MODE=true
DEFAULT_SIGNAL_EXPIRY_MINUTES=5
DEFAULT_LOT_SIZE=0.01
SPLIT_TICKET_DEMO_PARTIAL_MODE=true
TP1_LOT=0.02
TP2_LOT=0.01
TP3_LOT=0.01
MAX_SPREAD_POINTS=500
MAX_SLIPPAGE_POINTS=100
