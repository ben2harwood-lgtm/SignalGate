DATABASE_URL=sqlite:///./signalgate.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_BASE_URL=http://127.0.0.1:8000

TELEGRAM_BOT_TOKEN=replace_me
ADMIN_TELEGRAM_IDS=123456789
# Hosted mode: server-held secret sent by the shared Telegram bot for admin API calls.
ADMIN_API_KEY=
# Limited provider identities can submit/confirm signal input but cannot use admin controls.
SIGNAL_PROVIDER_TELEGRAM_IDS=
SIGNAL_PROVIDER_API_KEY=
# Optional local/demo provider enrolment code. Do not use this as production auth.
SIGNAL_PROVIDER_INVITE_CODE=
# Hosted mode: protects /register_user; only the shared bot should know it.
REGISTRATION_API_KEY=

# Shared EA service credential. Hosted EA calls also present the customer's
# license key in X-SG-License-Key so commands/reports are tenant-bound.
EA_API_KEY=local-demo-ea-key

# Screenshot reading:
# Use "claude" with ANTHROPIC_API_KEY for real image extraction.
# Use "fake" only for offline/demo plumbing tests.
SIGNAL_EXTRACTOR=claude
ANTHROPIC_API_KEY=replace_me
SIGNAL_EXTRACTOR_MODEL=claude-sonnet-4-5

# HOSTED MULTI-CUSTOMER MODE
# Local/solo demo: false. Hosted: true.
# Hosted startup fails closed unless PostgreSQL, HTTPS, DEMO_ONLY_MODE=true and
# strong (32+ character) EA/admin/provider/registration secrets are configured.
REQUIRE_LICENSE=false
# DATABASE_URL=postgresql://signalgate:CHANGE_ME@localhost:5432/signalgate
# BACKEND_BASE_URL=https://api.example.com

DEMO_ONLY_MODE=true
DEFAULT_SIGNAL_EXPIRY_MINUTES=5
DEFAULT_LOT_SIZE=0.01
SPLIT_TICKET_DEMO_PARTIAL_MODE=true
TP1_LOT=0.02
TP2_LOT=0.01
TP3_LOT=0.01
MAX_SPREAD_POINTS=500
MAX_SLIPPAGE_POINTS=100
